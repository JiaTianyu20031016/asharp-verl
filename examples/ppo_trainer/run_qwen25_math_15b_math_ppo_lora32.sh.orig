#!/usr/bin/env bash
set -euo pipefail

# Logical batches stay fixed across 3 and 4 GPUs; only N_GPUS/CUDA devices change.
N_GPUS="${N_GPUS:-3}"
TOTAL_EPOCHS="${TOTAL_EPOCHS:-10}"
TOTAL_TRAINING_STEPS="${TOTAL_TRAINING_STEPS:-null}"
PYTHON_BIN="${PYTHON_BIN:-/data1/jty/anaconda3/envs/asharp-verl/bin/python}"
RUN_NAME="${RUN_NAME:-qwen25-math-15b-math-ppo-lora32-n4}"

if [[ "${N_GPUS}" != "3" && "${N_GPUS}" != "4" ]]; then
  echo "N_GPUS must be 3 or 4; got ${N_GPUS}" >&2
  exit 2
fi

TRAIN_FILE=/data1/jty/data/math_lighteval_boxed/train.parquet
VAL_FILE=/data1/jty/data/math_lighteval_boxed/test.parquet
MODEL_PATH=/data2/jty/models/Qwen2.5-Math-1.5B-Instruct
OUTPUT_DIR=/data1/jty/outputs/ppo_lora32_math/${RUN_NAME}

exec "${PYTHON_BIN}" -m verl.trainer.main_ppo \
  algorithm.adv_estimator=gae \
  algorithm.gamma=1.0 \
  algorithm.lam=1.0 \
  algorithm.lam_policy=0.95 \
  algorithm.lam_critic=1.0 \
  algorithm.use_kl_in_reward=False \
  data.train_files="${TRAIN_FILE}" \
  data.val_files="${VAL_FILE}" \
  data.train_batch_size=96 \
  data.max_prompt_length=512 \
  data.max_response_length=1024 \
  data.filter_overlong_prompts=True \
  data.truncation=error \
  data.shuffle=True \
  data.seed=42 \
  actor_rollout_ref.model.path="${MODEL_PATH}" \
  actor_rollout_ref.model.lora_rank=32 \
  actor_rollout_ref.model.lora_alpha=32 \
  'actor_rollout_ref.model.target_modules=[q_proj,k_proj,v_proj,o_proj,gate_proj,up_proj,down_proj]' \
  actor_rollout_ref.model.use_remove_padding=True \
  actor_rollout_ref.model.enable_gradient_checkpointing=True \
  actor_rollout_ref.actor.optim.lr=5e-6 \
  actor_rollout_ref.actor.model_init_seed=42 \
  actor_rollout_ref.actor.optim.lr_warmup_steps=10 \
  actor_rollout_ref.actor.optim.lr_scheduler_type=constant \
  actor_rollout_ref.actor.ppo_mini_batch_size=96 \
  actor_rollout_ref.actor.ppo_micro_batch_size_per_gpu=16 \
  actor_rollout_ref.actor.ppo_epochs=1 \
  actor_rollout_ref.actor.shuffle=False \
  actor_rollout_ref.actor.clip_ratio=0.2 \
  actor_rollout_ref.actor.clip_ratio_low=0.2 \
  actor_rollout_ref.actor.clip_ratio_high=0.2 \
  actor_rollout_ref.actor.clip_ratio_c=1.0e10 \
  actor_rollout_ref.actor.use_kl_loss=False \
  actor_rollout_ref.actor.entropy_coeff=0 \
  actor_rollout_ref.actor.fsdp_config.param_offload=False \
  actor_rollout_ref.actor.fsdp_config.optimizer_offload=False \
  actor_rollout_ref.rollout.name=vllm \
  actor_rollout_ref.rollout.n=4 \
  actor_rollout_ref.rollout.tensor_model_parallel_size=1 \
  actor_rollout_ref.rollout.log_prob_micro_batch_size_per_gpu=16 \
  actor_rollout_ref.rollout.gpu_memory_utilization=0.6 \
  actor_rollout_ref.rollout.load_format=safetensors \
  actor_rollout_ref.rollout.layered_summon=True \
  actor_rollout_ref.rollout.val_kwargs.top_p=1.0 \
  actor_rollout_ref.rollout.val_kwargs.temperature=1.0 \
  actor_rollout_ref.rollout.val_kwargs.n=4 \
  actor_rollout_ref.rollout.val_kwargs.do_sample=True \
  critic.model.path="${MODEL_PATH}" \
  critic.model.lora_rank=32 \
  critic.model.lora_alpha=32 \
  'critic.model.target_modules=[q_proj,k_proj,v_proj,o_proj,gate_proj,up_proj,down_proj]' \
  critic.model.use_remove_padding=True \
  critic.model.enable_gradient_checkpointing=False \
  critic.optim.lr=1e-5 \
  critic.model_init_seed=42 \
  critic.optim.lr_warmup_steps=10 \
  critic.optim.lr_scheduler_type=constant \
  critic.ppo_mini_batch_size=96 \
  critic.ppo_micro_batch_size_per_gpu=16 \
  critic.ppo_epochs=1 \
  critic.shuffle=False \
  critic.model.fsdp_config.param_offload=False \
  critic.model.fsdp_config.optimizer_offload=False \
  trainer.critic_warmup=0 \
  trainer.logger='["console"]' \
  trainer.project_name=ppo_lora32_math \
  trainer.experiment_name="${RUN_NAME}" \
  trainer.n_gpus_per_node="${N_GPUS}" \
  trainer.nnodes=1 \
  trainer.total_epochs="${TOTAL_EPOCHS}" \
  trainer.total_training_steps="${TOTAL_TRAINING_STEPS}" \
  trainer.val_before_train=True \
  trainer.test_freq=77 \
  trainer.save_freq=77 \
  trainer.max_actor_ckpt_to_keep=2 \
  trainer.max_critic_ckpt_to_keep=2 \
  trainer.resume_mode=auto \
  trainer.default_local_dir="${OUTPUT_DIR}" \
  "$@"
